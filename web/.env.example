# Public site URL (SEO / canonical). Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Contact form delivery — configure AT LEAST ONE channel
# Recommended for China teams: Feishu / DingTalk / WeCom webhook (no mailbox needed)
# -----------------------------------------------------------------------------

# 1) Chat webhook (auto-detect Feishu / DingTalk / WeCom by URL)
# Feishu:   https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# DingTalk: https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
# WeCom:    https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
CONTACT_WEBHOOK_URL=

# Optional override if URL cannot be auto-detected: feishu | dingtalk | wecom | webhook
CONTACT_WEBHOOK_TYPE=

# 2) Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) Email via Resend (optional)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# 4) Formspree endpoint (optional), e.g. https://formspree.io/f/xxxxxx
CONTACT_FORMSPREE_URL=
